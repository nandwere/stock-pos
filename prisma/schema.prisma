// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id           String   @id @default(cuid())
  merchantId   String
  key          String                    // slug, unique per merchant
  name         String
  description  String?
  level        Int      @default(10)     // 1–99 custom, 100 = Admin
  isAdmin Boolean  @default(false)  // full access, locked
  isSystem     Boolean  @default(false)  // seeded, can't be deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  users    User[]
  grants   RoleGrant[]

  @@unique([merchantId, key])
  @@index([merchantId])
}

model RoleGrant {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model PermissionGroup {
  id          String       @id @default(cuid())
  key         String       @unique
  label       String
  sortOrder   Int          @default(0)
  isSystem    Boolean      @default(false) // seeded groups can't be deleted
  permissions Permission[]
}

model Permission {
  id           String          @id @default(cuid())
  key          String          @unique      // what hasPermission('...') checks
  label        String
  groupId      String
  sortOrder    Int             @default(0)
  isSystem     Boolean         @default(false) // seeded permissions can't be deleted
  group        PermissionGroup @relation(fields: [groupId], references: [id])
  adminOnly  Boolean  @default(false)
  defaultRoleKeys String[] @default([])

  @@index([groupId])
}

enum TransactionType {
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  SALE
  DAMAGE
  THEFT
  EXPIRY
  CORRECTION
  RETURN
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  CREDIT
}

// ─────────────────────────────────────────────
// Plan  (managed by super admins from /plans)
// ─────────────────────────────────────────────
// Merchant.plan stores Plan.key, so existing values ('FREE', 'STARTER', ...)
// keep working. maxProducts / maxUsers: null = unlimited.
// features holds keys from FEATURES in src/lib/plans.ts.

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  price       Int      @default(0) // whole currency units per month (KES)
  contactOnly Boolean  @default(false) // shown as "Contact us", no self-serve payment
  maxProducts Int?
  maxUsers    Int?
  features    String[]
  color       String   @default("gray")
  isPopular   Boolean  @default(false)
  isPublic    Boolean  @default(true) // listed on the merchant /upgrade page
  isActive    Boolean  @default(true) // can be assigned to merchants
  isDefault   Boolean  @default(false) // plan given to new merchants
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchants       Merchant[]
  paymentRequests PaymentRequest[]

  @@index([sortOrder])
}

// ─────────────────────────────────────────────
// Merchant  (tenant root)
// ─────────────────────────────────────────────

model Merchant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique // e.g. "acme-shop" → acme-shop.yourapp.com
  email       String       @unique // billing / contact email
  phone       String?
  address     String?
  logoUrl     String?
  currency    String       @default("KES")
  timezone    String       @default("Africa/Nairobi")
  plan        String       @default("FREE")
  isActive    Boolean      @default(true)
  storefrontEnabled  Boolean  @default(false)
  storefrontTagline String?
  deliveryFee    Decimal @default(0)  @db.Decimal(10, 3)
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  storefrontPhone     String?
  storefrontWhatsapp  String?
  storefrontEmail     String?
  storefrontAddress   String?
  storefrontLat       Decimal? @db.Decimal(9, 6)
  storefrontLng       Decimal? @db.Decimal(9, 6)
  storefrontHours     String?   // e.g. "Mon–Sat 8am–7pm"

  // Relations
  planConfig        Plan              @relation(fields: [plan], references: [key], onDelete: Restrict)
  users             User[]
  categories        Category[]
  products          Product[]
  sales             Sale[]
  stockCounts       StockCount[]
  adjustments       StockAdjustment[]
  dailySummaries    DailySummary[]
  shifts            Shift[]
  settings          Settings[]
  otpCodes          OtpCode[]
  paymentRequests   PaymentRequest[]
  suppliers         Supplier[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  orders            Order[]
  draftSales DraftSale[]
  stockMovements StockMovement[]
  priceHistory   PriceHistory[]
  salePayments SalePayment[]
  roles Role[]

  @@index([slug])
  @@index([email])
  @@index([plan])
}

model User {
  id         String   @id @default(cuid())
  merchantId String
  email      String   @unique
  name       String
  isSuperAdmin Boolean @default(false)
  roleId          String?
  role      Role?   @relation(fields: [roleId], references: [id])
  password   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  passwordChangedAt  DateTime @default(now())
  mustChangePassword Boolean  @default(false)

  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sales            Sale[]
  stockCounts      StockCount[]
  adjustments      StockAdjustment[]
  shifts           Shift[]
  expenses         Expense[]
  expenseApprovals ExpenseApproval[]
  draftSales DraftSale[]
  stockMovements StockMovement[]
  priceChanges   PriceHistory[]
  salePayments SalePayment[]

  // Email unique per merchant, not globally
  @@unique([merchantId, email])
  @@index([merchantId])
  @@index([merchantId, roleId])
  @@index([email])
}

model Category {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([merchantId, name])
  @@index([merchantId])
}

model Product {
  id           String   @id @default(cuid())
  merchantId   String
  name         String
  description  String?
  sku          String  
  barcode      String?
  categoryId   String
  costPrice    Decimal  @db.Decimal(10, 3)
  sellingPrice Decimal  @db.Decimal(10, 3)
  currentStock Decimal  @default(0)
  reorderLevel Decimal  @default(0)
  unit         String
  isService    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  imageUrl          String?
  imagePublicId     String?
  showOnStorefront  Boolean   @default(true)

  merchant    Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category    Category          @relation(fields: [categoryId], references: [id])
  saleItems   SaleItem[]
  stockCounts StockCount[]
  adjustments StockAdjustment[]
  // In Product model — add relation:
  supplierId  String?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  orderItems  OrderItem[]
  draftItems DraftSaleItem[]
  stockMovements StockMovement[]
  priceHistory   PriceHistory[]

  // SKU and barcode unique per merchant
  @@unique([merchantId, sku])
  @@unique([merchantId, barcode])
  @@index([merchantId])
  @@index([merchantId, categoryId])
  @@index([merchantId, currentStock])
}

model Sale {
  id            String        @id @default(cuid())
  merchantId    String
  saleNumber    String        @unique
  userId        String
  customerName  String?
  customerPhone  String?   // required at the API layer when paymentMethod == CREDIT
  dueDate        DateTime? // required at the API layer when paymentMethod == CREDIT
  reminderSentAt DateTime? // null = not yet notified; set once the cron job sends it
  notifiedAt    DateTime?  
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(10, 3)
  tax           Decimal       @default(0) @db.Decimal(10, 3)
  discount      Decimal       @default(0) @db.Decimal(10, 3)
  total         Decimal       @db.Decimal(10, 3)
  amountPaid    Decimal       @db.Decimal(10, 3)
  change        Decimal       @default(0) @db.Decimal(10, 3)
  notes         String?
  createdAt     DateTime      @default(now())

  settledAt DateTime?   // set when a credit sale is fully paid; null = still open
  payments  SalePayment[]
  merchant Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id])
  items    SaleItem[]

  // Sale number unique per merchant
  @@unique([merchantId, saleNumber])
  @@index([merchantId])
  @@index([merchantId, userId])
  @@index([merchantId, createdAt])
  @@index([merchantId, paymentMethod])
  @@index([merchantId, paymentMethod, settledAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 3)
  costPrice Decimal @default(0) @db.Decimal(10, 3)
  discount  Decimal @default(0) @db.Decimal(10, 3)
  subtotal  Decimal @db.Decimal(10, 3)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model StockCount {
  id          String   @id @default(cuid())
  merchantId  String
  productId   String
  userId      String
  expectedQty Decimal  @db.Decimal(10, 3)
  actualQty   Decimal  @db.Decimal(10, 3)
  variance    Decimal  @db.Decimal(10, 3)
  notes       String?
  countDate   DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([merchantId])
  @@index([merchantId, productId])
  @@index([merchantId, countDate])
}

model StockAdjustment {
  id         String          @id @default(cuid())
  merchantId String
  productId  String
  userId     String
  type       TransactionType
  quantity   Decimal         @db.Decimal(10, 3)
  reason     String
  notes      String?
  createdAt  DateTime        @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([merchantId])
  @@index([merchantId, productId])
  @@index([merchantId, createdAt])
  @@index([merchantId, type])
}

model DailySummary {
  id             String   @id @default(cuid())
  merchantId     String
  date           DateTime @unique @db.Date
  totalSales     Decimal  @db.Decimal(10, 3)
  totalCost      Decimal  @db.Decimal(10, 3)
  grossProfit    Decimal  @db.Decimal(10, 3)
  recordedSales  Decimal  @db.Decimal(10, 3)
  estimatedSales Decimal  @db.Decimal(10, 3)
  cashSales      Decimal  @db.Decimal(10, 3)
  cardSales      Decimal  @db.Decimal(10, 3)
  mobilePayments Decimal  @db.Decimal(10, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // One summary per merchant per day
  @@unique([merchantId, date])
  @@index([merchantId])
  @@index([merchantId, date])
}

model Shift {
  id           String    @id @default(cuid())
  merchantId   String
  userId       String
  startTime    DateTime
  endTime      DateTime?
  openingCash  Decimal   @db.Decimal(10, 3)
  closingCash  Decimal?  @db.Decimal(10, 3)
  expectedCash Decimal?  @db.Decimal(10, 3)
  variance     Decimal?  @db.Decimal(10, 3)
  notes        String?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([merchantId])
  @@index([merchantId, userId])
  @@index([merchantId, startTime])
}

model Settings {
  id          String   @id @default(cuid())
  merchantId  String
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Key unique per merchant
  @@unique([merchantId, key])
  @@index([merchantId])
}

model OtpCode {
  id         String    @id @default(cuid())
  merchantId String
  email      String
  code       String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  purpose  String @default("RESET")   // existing forgot-password rows stay "RESET"
  attempts Int    @default(0)
  
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([email, merchantId, purpose])
  @@index([email, merchantId])
  @@index([code])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model PaymentRequest {
  id              String        @id @default(cuid())
  merchantId      String
  plan            String
  transactionCode String        @unique // prevents double-submissions
  status          PaymentStatus @default(PENDING)
  notes           String? // admin can leave a rejection reason
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  planConfig Plan     @relation(fields: [plan], references: [key], onDelete: Restrict)

  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
}

// ── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  email       String?
  phone       String?
  address     String?
  contactName String?
  taxPin      String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  expenses Expense[]
  products Product[] // supplier can be linked to products

  @@unique([merchantId, name])
  @@index([merchantId])
  @@index([merchantId, isActive])
}

// ── Expense Categories ───────────────────────────────────────────────────────

model ExpenseCategory {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  description String?
  color       String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([merchantId, name])
  @@index([merchantId])
}

// ── Expenses ─────────────────────────────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  VOIDED
}

enum ExpenseType {
  OPERATIONAL
  CAPITAL
  RECURRING
  ONE_TIME
}

model Expense {
  id               String         @id @default(cuid())
  merchantId       String
  userId           String
  supplierId       String?
  categoryId       String?
  expenseNumber    String
  type             ExpenseType    @default(OPERATIONAL)
  status           ExpenseStatus  @default(DRAFT)
  description      String
  amount           Decimal        @db.Decimal(10, 3)
  tax              Decimal        @default(0) @db.Decimal(10, 3)
  total            Decimal        @db.Decimal(10, 3)
  currency         String         @default("KES")
  expenseDate      DateTime
  dueDate          DateTime?
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  paymentReference String?
  receiptUrl       String?
  notes            String?
  isRecurring      Boolean        @default(false)
  recurringDay     Int? // day of month for recurring
  tags             String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  merchant  Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])
  supplier  Supplier?         @relation(fields: [supplierId], references: [id])
  category  ExpenseCategory?  @relation(fields: [categoryId], references: [id])
  approvals ExpenseApproval[]
  items     ExpenseItem[]

  @@unique([merchantId, expenseNumber])
  @@index([merchantId])
  @@index([merchantId, status])
  @@index([merchantId, supplierId])
  @@index([merchantId, categoryId])
  @@index([merchantId, expenseDate])
  @@index([merchantId, type])
}

model ExpenseItem {
  id          String  @id @default(cuid())
  expenseId   String
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 3)
  subtotal    Decimal @db.Decimal(10, 3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model ExpenseApproval {
  id         String    @id @default(cuid())
  expenseId  String
  approverId String
  status     String // APPROVED | REJECTED
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  expense  Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approver User    @relation(fields: [approverId], references: [id])

  @@index([expenseId])
  @@index([approverId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SCHEMA ADDITIONS — public storefront + pay-on-delivery orders
//
// This is a PATCH, not a replacement file. Add:
//   1. The new OrderStatus enum, anywhere with your other enums.
//   2. The two new fields + one new relation line inside your existing
//      `model Merchant { ... }` block (marked below).
//   3. One new relation line inside your existing `model Product { ... }`
//      block (marked below).
//   4. The two new models (Order, OrderItem) anywhere in the file.
//
// Then run: npx prisma migrate dev --name add_storefront_orders
// ═══════════════════════════════════════════════════════════════════════════

enum OrderStatus {
  PENDING // just placed, awaiting merchant confirmation
  CONFIRMED // merchant has accepted it, preparing for delivery
  OUT_FOR_DELIVERY
  DELIVERED // triggers Sale conversion — see OrderItem notes below
  CANCELLED
}

// ─────────────────────────────────────────────
// Add to your EXISTING `model Merchant { ... }` block:
// ─────────────────────────────────────────────
//   storefrontEnabled Boolean @default(false)
//   deliveryFee       Decimal @db.Decimal(10, 3) @default(0)
//   storefrontTagline String?
//
// ...and add this line alongside your other relation arrays (sales, products, etc.):
//   orders            Order[]

// ─────────────────────────────────────────────
// Add to your EXISTING `model Product { ... }` block, alongside saleItems etc:
// ─────────────────────────────────────────────
//   orderItems        OrderItem[]

// ─────────────────────────────────────────────
// New models
// ─────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  merchantId  String
  orderNumber String @unique

  customerName    String
  customerPhone   String
  deliveryAddress String
  deliveryNotes   String?

  status OrderStatus @default(PENDING)

  subtotal    Decimal @db.Decimal(10, 3)
  deliveryFee Decimal @default(0) @db.Decimal(10, 3)
  total       Decimal @db.Decimal(10, 3)

  // Set once a staff member marks the order DELIVERED — how the customer
  // actually paid the driver/rider at the door. Nullable until then.
  paymentMethod PaymentMethod?

  // Soft link to the Sale created on delivery (see stock.ts) — kept as a
  // plain scalar rather than a formal Prisma relation so this patch doesn't
  // need to touch your existing Sale model. Add a real @relation later if
  // you want type-safe joins.
  saleId String? @unique

  confirmedAt      DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@unique([merchantId, orderNumber])
  @@index([merchantId])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 3)
  subtotal  Decimal @db.Decimal(10, 3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model DraftSale {
  id            String   @id @default(cuid())
  merchantId    String
  userId        String
  draftNumber   String
  customerName  String?
  customerPhone String?
  notes         String?
  subtotal      Decimal  @db.Decimal(10, 3)
  discount      Decimal  @default(0) @db.Decimal(10, 3)
  total         Decimal  @db.Decimal(10, 3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])
  items    DraftSaleItem[]

  @@unique([merchantId, draftNumber])
  @@index([merchantId, userId])
  @@index([merchantId, updatedAt])
}

model DraftSaleItem {
  id        String  @id @default(cuid())
  draftId   String
  productId String
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 3)
  discount  Decimal @default(0) @db.Decimal(10, 3)
  subtotal  Decimal @db.Decimal(10, 3)

  draft   DraftSale @relation(fields: [draftId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id])

  @@index([draftId])
  @@index([productId])
}

enum StockMovementType {
  OPENING            // initial stock when the product was created / backfilled
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  DAMAGE
  THEFT
  EXPIRY
  CORRECTION
  COUNT              // stock-count reconciliation
  MANUAL_EDIT        // stock changed via the product edit form
}

model StockMovement {
  id             String            @id @default(cuid())
  merchantId     String
  productId      String
  userId         String?
  type           StockMovementType
  quantityChange Decimal           @db.Decimal(10, 3) // signed: -2.500 for a sale
  stockBefore    Decimal           @db.Decimal(10, 3)
  stockAfter     Decimal           @db.Decimal(10, 3)
  referenceType  String?           // "SALE" | "ORDER" | "ADJUSTMENT" | "STOCK_COUNT"
  referenceId    String?
  note           String?
  createdAt      DateTime          @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([merchantId, productId, createdAt])
  @@index([merchantId, createdAt])
  @@index([referenceType, referenceId])
}

model PriceHistory {
  id              String   @id @default(cuid())
  merchantId      String
  productId       String
  userId          String?
  oldCostPrice    Decimal? @db.Decimal(10, 3) // null on the initial record
  newCostPrice    Decimal  @db.Decimal(10, 3)
  oldSellingPrice Decimal? @db.Decimal(10, 3)
  newSellingPrice Decimal  @db.Decimal(10, 3)
  reason          String?
  createdAt       DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([merchantId, productId, createdAt])
}

enum SalePaymentKind {
  SALE       // paid in full at the till (cash / M-Pesa / card sale)
  DEPOSIT    // upfront part-payment on a credit sale
  REPAYMENT  // later payment against a credit balance
}

model SalePayment {
  id           String          @id @default(cuid())
  merchantId   String
  saleId       String
  userId       String?
  kind         SalePaymentKind
  method       PaymentMethod   // CASH | CARD | MOBILE_MONEY (never CREDIT)
  amount       Decimal         @db.Decimal(10, 3)
  balanceAfter Decimal         @db.Decimal(10, 3) // what the customer still owes after this payment
  reference    String?         // M-Pesa code, card slip no., etc.
  notes        String?
  createdAt    DateTime        @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  // Stops the same M-Pesa code being recorded twice (NULLs are allowed repeatedly)
  @@unique([merchantId, reference])
  @@index([merchantId, saleId])
  @@index([merchantId, createdAt])
  @@index([merchantId, method, createdAt])
}